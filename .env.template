# ==============================================================================
# MonMon Unified Environment Configuration Template
# Copy this file to '.env' at the repository root and fill in your secrets.
# '.env' is strictly gitignored and must never be committed.
# ==============================================================================

# Application Security
# Generate a secure key using: openssl rand -hex 32
PLAY_SECRET_KEY=changeme_to_a_secure_random_string_min_32_chars
APPLICATION_SECRET=changeme_to_a_secure_random_string_min_32_chars

# Database (PostgreSQL)
POSTGRES_PASSWORD=changeme_to_your_db_password
DB_PASSWORD=changeme_to_your_db_password
DB_USERNAME=postgres
DB_URL=postgres://postgres:changeme_to_your_db_password@127.0.0.1:5433/monmon-play

# Authentication (OpenID Connect / Rauthy)
BASE_URL=https://monmon.dryark.uk
OIDC_DISCOVERY_URI=https://identity.dryark.uk/auth/realms/monmon/.well-known/openid-configuration
OIDC_CLIENT_ID=monmon-web
OIDC_CLIENT_SECRET=changeme_to_your_64_char_hex_oidc_client_secret
KEYCLOAK_ADMIN_PASSWORD=changeme_to_admin_password
INBREWJ_PASSWORD=changeme_to_inbrewj_password
CAITY_PASSWORD=changeme_to_caity_password

# Rauthy Cluster & Encryption Secrets
RAUTHY_SECRET_RAFT=changeme_to_48_char_alphanumeric_raft_secret
RAUTHY_SECRET_API=changeme_to_48_char_alphanumeric_api_secret
RAUTHY_ENC_KEY_ID=2026-11-09
RAUTHY_ENC_KEY=changeme_to_base64_encoded_32_byte_key

# Mistral AI (Used by both MonMon Ed/NomMon and LegMon OCR extractor)
# Free tier keys available at https://console.mistral.ai/
MISTRAL_API_KEY=changeme_to_your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# Monzo Developer API (Optional - Personal Access Tokens can be pasted in UI)
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=https://monmon.dryark.uk/bank/monzo/callback

# LegMon Service (PDF Statement OCR & Mistral Extraction)
PORT=9005
LEGMON_URL=http://localhost:9005
MONMON_URL=http://127.0.0.1:9000

# Rauthy SMTP configuration
RAUTHY_ADMIN_EMAIL=jason@dryark.uk
EMAIL_SUB_PREFIX=MonMon Identity
SMTP_URL=smtp.mailbox.org
SMTP_PORT=587
SMTP_USERNAME=jason@dryark.uk
SMTP_PASSWORD=changeme_to_your_smtp_password
SMTP_FROM=MonMon <jason@dryark.uk>
SMTP_TLS_MODE=starttls
