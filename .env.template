# ==============================================================================
# MonMon Unified Environment Configuration Template
# Copy this file to '.env' at the repository root and fill in your secrets.
# '.env' is strictly gitignored and must never be committed.
# ==============================================================================

# Application Security
# Generate a secure key using: head -c 64 /dev/urandom | base64
APPLICATION_SECRET=changeme_to_a_secure_random_string_min_32_chars

# Database (PostgreSQL)
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/monmon-play
DB_USERNAME=postgres
DB_PASSWORD=changeme_to_your_db_password

# Authentication (OpenID Connect / Keycloak)
BASE_URL=https://boom.dryark.uk
OIDC_DISCOVERY_URI=https://identity.boom.dryark.uk/auth/realms/monmon/.well-known/openid-configuration
OIDC_CLIENT_ID=monmon-web
OIDC_CLIENT_SECRET=changeme_to_your_keycloak_client_secret

# Mistral AI (Used by both MonMon Ed/NomMon and LegMon OCR extractor)
# Free tier keys available at https://console.mistral.ai/
MISTRAL_API_KEY=changeme_to_your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# Monzo Developer API (Optional - Personal Access Tokens can be pasted in UI)
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=https://boom.dryark.uk/bank/monzo/callback

# LegMon Service (PDF Statement OCR & Mistral Extraction)
PORT=9005
LEGMON_URL=http://localhost:9005
MONMON_URL=http://127.0.0.1:9000
